                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "examples": {
                                    "MissingID": {
                                        "value": {
                                            "error": "No ID supplied"
                                        }
                                    },
                                    "IncorrectData": {
                                        "value": {
                                            "error": "Incorrect or missing data"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Collection not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Recipe collection with this ID is not found: 01a19e84-55c5-7590-83b5-2c8b4b3c0ffe"
