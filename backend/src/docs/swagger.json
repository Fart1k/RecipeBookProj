                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "404": {
                        "description": "Collection not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Collection with this ID is not found: 01a1c463-53d3-714f-8ad5-83119e0cd2ce"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}