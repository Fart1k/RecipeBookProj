{
    "openapi": "3.0.3",
    "info": {
        "title": "Recipe Book API",
        "version": "1.0.0",
        "description": "API for Recipe Book application"
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        },
        "responses": {
            "UnauthorizedError": {
                "description": "Missing or invalid authentication token",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "error": {
                                    "type": "string",
                                    "example": "Invalid or expired token"
                                }
                            }
                        }
                    }
                }
            },
            "AccessDenied": {
                "description": "Access denied. You dont have enoght permission",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "error": {
                                    "type": "string",
                                    "example": "Access denied"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    
    "tags": [
        {
            "name": "Recipes",
            "description": "Everything about recipes"
        },
        {
            "name": "Users",
            "description": "User management and authentication"
        },
        {
            "name": "UserRecipesCollections",
            "description": "User recipe collection management"
        },
        {
            "name": "Comments",
            "description": "Recipe comments and ratings"
        },
        {
            "name": "Admin",
            "description": "Administration and moderation"
        }
    ],
    "paths": {
        "/recipes": {
            "get": {
                "tags": ["Recipes"],
                "summary": "Get all public and approved recipes",
                "responses": {
                    "200": {
                        "description": "A list of recipes",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "properties": {
                                            "id": {
                                                "type": "string",
                                                "format": "uuid",
                                                "example": "123e4567-e89b-12d3-a456-426614174000"
                                            },
                                            "RecipeTitle": {
                                                "type": "string",
                                                "example": "Spaghetti Carbonara"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": ["Recipes"],
                "summary": "Create new recipe",
                "description": "Creates a new recipe and submits it for admin approval",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "RecipeTitle",
                                    "Instructions",
                                    "Ingredients",
                                    "IsVisibleToOther"
                                ],
                                "properties": {
                                    "RecipeTitle" : {
                                        "type": "string",
                                        "example": "Spaghetti Carbonara"
                                    },
                                    "Instructions": {
                                        "type": "string",
                                        "example": "Boil spaghetti and mix with eggs and cheese"
                                    },
                                    "Ingredients": {
                                        "type": "string",
                                        "example": "Spaghetti, eggs, cheese"
                                    },
                                    "IsVisibleToOther": {
                                        "type": "boolean",
                                        "example": false
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Recipe succsessfully created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "format": "uuid",
                                            "example": "123e4567-e89b-12d3-a456-426614174000"
                                        },
                                        "RecipeTitle": {
                                            "type": "string",
                                            "example": "Spaghetti Carbonara"
                                        },
                                        "Instructions": {
                                            "type": "string",
                                            "example": "Boil spaghetti and mix with eggs and cheese."
                                        },
                                        "Ingredients": {
                                            "type": "string",
                                            "example": "Spaghetti, eggs, Parmesan, pancetta"
                                        },
                                        "IsVisibleToOther": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "Status": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "UserId": {
                                            "type": "string",
                                            "format": "uuid"
                                        },
                                        "createdAt": {
                                            "type": "string",
                                            "format": "date-time"
                                        },
                                        "updatedAt": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Missing parameters or invalid data",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Missing parameters, please review data."
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid authentication token",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Invalid or expired token"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/recipes/{ID}": {
            "get": {
                "tags": ["Recipes"],
                "summary": "Get one recipe",
                "parameters": [
                    {
                        "name": "ID",
                        "in": "path",
                        "required": true,
                        "description": "Unique recipe ID",
                        "schema": {
                            "type": "string",
                            "format": "uuid",
                            "example": "123e4567-e89b-12d3-a456-426614174000"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Recipe successfully found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "items": {
                                        "properties": {
                                            "id": {
                                                "type": "string",
                                                "format": "uuid",
                                                "example": "123e4567-e89b-12d3-a456-426614174000"
                                            },
                                            "RecipeTitle": {
                                                "type": "string",
                                                "example": "Spaghetti Carbonara"
                                            },
                                            "Instructions": {
                                                "type": "string",
                                                "example": "1. Boil spaghetti in salted water. 2. Fry pancetta until crispy. 3. Mix eggs with grated Parmesan. 4. Combine hot spaghetti with pancetta. 5. Add egg mixture and stir until creamy. Serve immediately."
                                            },
                                            "Ingredients": {
                                                "type": "string",
                                                "example": "Spaghetti, eggs, cheese"
                                            },
                                            "ImageURL": {
                                                "type": "string",
                                                "nullable": true,
                                                "example": null
                                            },
                                            "IsVisibleToOther": {
                                                "type": "boolean",
                                                "example": false
                                            },
                                            "RatingOverall": {
                                                "type": "integer",
                                                "nullable": true,
                                                "example": null
                                            },
                                            "Status": {
                                                "type": "boolean", 
                                                "example": true
                                            },
                                            "createdAt": {
                                                "type": "string",
                                                "format": "date-time"
                                            },
                                            "updatedAt": {
                                                "type": "string",
                                                "format": "date-time"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Recipe not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Recipe with this ID is not found: 123e4567-e89b-12d3-a456-426614174000"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": ["Recipes"],
                "summary": "Modify an existing recipe data",
                "description": "Updates an existing recipe bt its ID",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "ID",
                        "required": true,
                        "in": "path",
                        "description": "Unique recipe ID",
                        "schema": {
                            "type": "string",
                            "format": "uuid",
                            "example": "01a1c462-5d99-771d-99d3-ae6307063bfc"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "RecipeTitle": {
                                        "type": "string",
                                        "example": "Modified Spaghetti Carbonara"
                                    },
                                    "Instructions": {
                                        "type": "string",
                                        "example": "Boil spaghetti and bla bawldpaowkdpoawkdopa"
                                    },
                                    "Ingredients": {
                                        "type": "string",
                                        "example": "Milk, sugar"
                                    },
                                    "IsVisibleToOther": {
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "ImageUrl": {
                                        "type": "string",
                                        "nullable": true,
                                        "example": null
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Recipe successfully modified",
                        "headers": {
                            "Location": {
                                "description": "URL of the modified recipe",
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "RecipeTitle": {
                                            "type": "string",
                                            "example": "Modified Spaghetti Carbonara"
                                        },
                                        "Instructions": {
                                            "type": "string",
                                            "example": "Boil spaghetti and prepare the sauce."
                                        },
                                        "Ingredients": {
                                            "type": "string",
                                            "example": "Spaghetti, eggs, Parmesan, bacon"
                                        },
                                        "IsVisibleToOther": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "ImageUrl": {
                                            "type": "string",
                                            "nullable": true,
                                            "example": null
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "No ID supplied"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Recipe not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Recipe with this ID is not found. 01a1c462-5d99-771d-99d3-ae6307063bfc"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/UnauthorizedError"
                    },
                    "403": {
                        "$ref": "#/components/responses/AccessDenied"
                    }
                }
            },
            "delete": {
                "tags": ["Recipes"],
                "summary": "Delete a recipe",
                "description": "Deletes an existing recipe by ID",
                "parameters": [
                    {
                        "name": "ID",
                        "required": true,
                        "in": "path",
                        "description": "Unique recipe ID",
                        "schema": {
                            "type": "string",
                            "format": "uuid",
                            "example": "01a1c462-5d99-771d-99d3-ae6307063bfc"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "404": {
                        "description": "Recipe not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Recipe with this ID is not found: 01a1c462-5d99-771d-99d3-ae6307063bfc"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },

        "/userrecipescollections": {
            "get": {
                "tags": ["UserRecipesCollections"],
                "summary": "Get all recipe collections",
                "responses": {
                    "200": {
                        "description": "Returns a list of recipe collections",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "properties": {
                                            "id": {
                                                "type": "string",
                                                "format": "uuid",
                                                "example": "01a1c462-5d99-771d-99d3-ae6307063bfc"
                                            },
                                            "CollectionName": {
                                                "type": "string",
                                                "example": "Dinner"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": ["UserRecipesCollections"],
                "summary": "Create new user recipes collection",
                "description": "Creates a new collection",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "CollectionName",
                                    "CollectionDescription",
                                    "RecipeIds"
                                ],
                                "properties": {
                                    "CollectionName": {
                                        "type": "string",
                                        "example": "Dinner"
                                    },
                                    "CollectionDescription": {
                                        "type": "string",
                                        "example": "Recipes for dinner"
                                    },
                                    "RecipeIds": {
                                        "type": "array",
                                        "items": {
                                            "type": "string",
                                            "format": "uuid"
                                        },
                                        "example": ["01a1c462-5d99-771d-99d3-ae6307063bfc"]
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Collection is successfully created",
                        "headers": {
                            "Location": {
                                "description": "URL of the created collection",
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "format": "uuid",
                                            "example": "01a1c462-5d99-771d-99d3-ae6307063bfc"
                                        },
                                        "CollectionName": {
                                            "type": "string",
                                            "example": "Dinner"
                                        },
                                        "CollectionDescription": {
                                            "type": "string",
                                            "example": "Recipes for collection"
                                        },
                                        "RecipeIds": {
                                            "type": "array",
                                            "items": {
                                                "type": "string",
                                                "format": "uuid"
                                            },
                                            "example": ["01a1c462-5d99-771d-99d3-ae6307063bfc"]
                                        },
                                        "UserId": {
                                            "type": "string",
                                            "format": "uuid",
                                            "example": "01a1c462-5d99-771d-99d3-ae6307063bfc"
                                        },
                                        "createdAt": {
                                            "type": "string",
                                            "format": "date-time"
                                        },
                                        "updatedAt": {
                                            "type": "string",
                                            "format": "date-time"
                                        },
                                        "User": {
                                            "type": "object",
                                            "description": "Collection creator",
                                            "properties": {
                                                "id": {
                                                    "type": "string",
                                                    "format": "uuid",
                                                    "example": "01a1c462-5d99-771d-99d3-ae6307063bfc"
                                                },
                                                "UserName": {
                                                    "type": "string",
                                                    "example": "Daun"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Missing parameters or invalid data",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Missing parameters, please review data."
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Unauthorized: Missing user token"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/userrecipescollections/{ID}": {
