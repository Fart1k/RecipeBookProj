{
    "openapi": "3.0.3",
    "info": {
        "title": "Recie Book API",
        "version": "1.0.0",
        "description": "API for Recipe Book application"
    },
    "paths": {
        "/recipes": {
            "get": {
                "summary": "Get all recipes",
                "responses": {
                    "200": {
                        "description": "A list of recipes",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "properties": {
                                            "id": {
                                                "type": "string",
                                                "example": "123e4567-e89b-12d3-a456-426614174000"
                                            },
                                            "RecipeTitle": {
                                                "type": "string",
                                                "example": "Spaghetti Carbonara"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}